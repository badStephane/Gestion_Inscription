{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Gestion des Inscriptions",
  "version": "0.1.4",
  "identifier": "com.badstephane.gestion-inscription",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Gestion des Inscriptions",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/badStephane/Gestion_Inscription/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzNjRCNzRFRDJGOENBMkEKUldRcXl2alNUcmRrazB0MGVMT05QdWszbWcycDNKb2lBOG90QkZWVEJHc3lOdVRzOW5RbExybXMK"
    }
  }
}
