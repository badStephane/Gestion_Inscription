# Mode démonstration
#
# Quand VITE_DEMO_MODE=true, l'application n'accède pas à SQLite : la couche
# de données est servie depuis des données fictives en mémoire (src/utils/demo.ts),
# l'écran de verrouillage est désactivé et un bandeau « démonstration » s'affiche.
#
# À utiliser uniquement pour la démo web (Vercel). Laisser vide / false pour
# l'application desktop normale.
VITE_DEMO_MODE=false
